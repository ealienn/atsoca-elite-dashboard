{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/signup.html", "dest": "/signup.html" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
